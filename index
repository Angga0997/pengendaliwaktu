else if(D.tm){const a=D.tm;if(a==='go'){if(!T)T={m:+$('#tmm').value,acc:0,run:0,course:$('#tmc').value};if(T.run){T.acc+=Date.now()-T.t0;T.run=0}else{T.t0=Date.now();T.run=1}}
else if(a==='end'){const c=cal();PRE.study={course:T.course,minutes:Math.round(c.fm),method:T.m===50?'50 menit':'25–5'};T=null;render();go('study');return}else if(a==='reset')T=null;else if(a==='rs'){S.sch[TAB]=SCH0[TAB];save()}}
else if(D.ex){if(D.ex==='json')dl('plms-cadangan.json',JSON.stringify(S));else{const k=$('#exk').value,rows=k==='hab'?Object.entries(S.hab).flatMap(([d,o])=>Object.entries(o).map(([kb,l])=>({d,kebiasaan:kb,level:l}))):L(k),cols=[...new Set(rows.flatMap(Object.keys))].filter(c=>c!=='id'),q=v=>'"'+String(v??'').replace(/"/g,'""')+'"';dl('plms-'+k+'.csv','\ufeff'+[cols.join(',')].concat(rows.map(r=>cols.map(c=>q(r[c])).join(','))).join('\n'))}return}else return;render()});
document.addEventListener('submit',e=>{const f=e.target,k=f.dataset.k,fm=f.dataset.f;if(!k&&!fm)return;e.preventDefault();const d=Object.fromEntries(new FormData(f));f.querySelectorAll('[type=number]').forEach(i=>d[i.name]=i.value===''?'':+i.value);
if(k){if(ED[k]){Object.assign(L(k).find(x=>x.id===ED[k]),d);ED[k]=null}else{L(k).push({id:uid(),...d});delete PRE[k]}}
else if(fm==='set')Object.assign(S.set,d);else if(fm==='sch')S.sch[TAB]=d.txt;else if(fm==='rev')S.rev[wk0(today())]=d;save();render();toast('Tersimpan ✓')});
document.addEventListener('change',e=>{const t=e.target;if(t.dataset.hd){HD=t.value||today();render()}else if(t.id==='imp'&&t.files[0]){const r=new FileReader();r.onload=()=>{try{const c=JSON.parse(r.result);if(!c.c)throw 0;S=c;norm();save();render();toast('Data dipulihkan ✓')}catch(x){toast('File tidak valid')}};r.readAsText(t.files[0])}});
async function dl(name,data){try{const d=window.claude&&await claude.use('downloads');if(!d)throw 0;await d.save({filename:name,data});toast('Ekspor dikirim ✓')}catch(e){toast('Ekspor tidak tersedia di tampilan ini')}}
setInterval(()=>{if(!T||PG!=='aka')return;const c=cal(),el=$('#tm');if(!el)return;if(c.done&&T.run){T.acc+=Date.now()-T.t0;T.run=0;navigator.vibrate&&navigator.vibrate(400);render();return}el.textContent=mmss(c.left);$('#tp').textContent=PH[T.m][c.i][0];if(T.last!==undefined&&T.last!==c.i&&navigator.vibrate)navigator.vibrate(300);T.last=c.i},500);
addEventListener('hashchange',()=>{PG=location.hash.slice(1)||'home';render()});render();
</script></body></html>
