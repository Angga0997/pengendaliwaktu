06.00|Kuliah (8–9 jam)
15.30|Makan & istirahat singkat
17.30|Peregangan ringan atau santai
19.00|Ibadah & makan malam
19.30|Belajar ringan 30–45 menit (opsional)
20.30|Tidur`,normal:`04.00|Bangun & ibadah Subuh
04.30|Tilawah, hafalan, murajaah (30 menit)
05.15|Persiapan & sarapan
06.30|Kuliah (± 6 jam)
13.00|Makan siang & istirahat
15.30|Olahraga (hari latihan) atau santai
18.30|Ibadah & makan malam
19.15|Belajar mandiri 1–2 sesi 50 menit
20.15|Pengetahuan umum / agama ringan
20.45|Tidur`,free:`04.00|Bangun & ibadah Subuh
04.30|Tilawah, hafalan, murajaah (30 menit)
06.00|Sarapan & santai
08.00|Belajar mandiri 2–3 sesi 50 menit
11.00|Olahraga atau aktivitas ringan
13.00|Makan siang & istirahat
15.00|Pengetahuan umum / agama, atau waktu bebas
17.00|Waktu santai & sosial
19.00|Ibadah & makan malam
20.30|Tidur`};
const LBLD={busy:'Padat',normal:'Normal',free:'Santai'};
const H=[{k:'quran',n:'Al-Qur’an',l:['Baca ≥ 5 menit','Tilawah + hafalan 20–30 menit','Hafalan lebih banyak + murajaah']},{k:'belajar',n:'Belajar mandiri',l:['≥ 30 menit (jika memungkinkan)','Sesuai target harian','Hingga 3 jam + pendalaman']},{k:'ilmu',n:'Pengetahuan umum/agama',l:['Baca satu halaman/artikel','Satu topik + catatan','Pendalaman + rangkuman']},{k:'makan',n:'Makan & nutrisi',l:['Makan teratur','Target kalori & protein terpenuhi','Target + air cukup + camilan protein']},{k:'tidur',n:'Tidur tepat waktu',l:['Tidur sebelum 22.00','Tidur 20.30–21.00','Tidur cukup + kualitas baik']},{k:'olahraga',n:'Olahraga / gerak',l:['Peregangan / jalan 10 menit','Sesi sesuai jadwal','Sesi + latihan tambahan']}];
const AUTO={quran:'quran',belajar:'study',ilmu:'know',makan:'food',tidur:'sleep',olahraga:'work'};
const LV=['1 · Belum memahami','2 · Mulai memahami','3 · Memahami','4 · Mampu menjelaskan kembali','5 · Mampu mengerjakan soal mandiri'];
const CATS=['Umum: Ekonomi & keuangan negara','Umum: APBN & perpajakan','Umum: Pemerintahan & birokrasi','Umum: Politik & hubungan internasional','Umum: Sejarah & geografi','Umum: Kepemimpinan','Umum: Isu nasional & internasional','Umum: Teknologi & dunia','Agama: Aqidah','Agama: Fiqih','Agama: Akhlak','Agama: Tafsir Al-Qur’an','Agama: Hadis','Agama: Sejarah Islam','Agama: Sirah Nabi'];
const TIP={'HP/notifikasi':'Coba taruh HP di ruangan lain atau mode pesawat selama sesi.','Mengantuk':'Coba metode 25–5, berdiri sebentar, dan cek jam tidur.','Materi sulit':'Mulai dari contoh soal atau cari penjelasan kedua, lalu catat bagian yang macet.','Lapar/haus':'Siapkan air dan camilan sebelum sesi.','Lingkungan':'Cari tempat belajar yang lebih tenang.'};
const LBL={weight:'Berat badan',food:'Makanan',water:'Air',work:'Olahraga',sleep:'Tidur',quran:'Al-Qur’an',tad:'Tadabbur',study:'Sesi belajar',course:'Mata kuliah',task:'Tugas',mat:'Materi',know:'Pengetahuan',mood:'Mood & energi',rest:'Waktu santai',grat:'Syukur',ref:'Refleksi harian',hab:'Kebiasaan'};
const CK=Object.keys(LBL).filter(k=>k!=='hab');
let S,ED={},PRE={},PEND=null,HD=today(),TAB='busy',T=null,PG=location.hash.slice(1)||'home',SYNC='memeriksa…',DBR=null,st;
const def=()=>({t:0,set:{h:165,w0:48,wt:55,rate:.35,kcal:2400,prot:80,air:2000,ayat:10,theme:''},c:{},hab:{},day:{},sch:{...SCH0},rev:{}});
function norm(){const d=def();S=S||d;S.set={...d.set,...S.set};S.sch={...d.sch,...S.sch};S.c=S.c||{};CK.forEach(k=>S.c[k]=S.c[k]||[]);['hab','day','rev'].forEach(k=>S[k]=S[k]||{})}
try{S=JSON.parse(localStorage.getItem(K))}catch(e){}norm();
const L=k=>S.c[k],on=(k,d)=>L(k).filter(x=>x.d===d),inR=(k,a,b)=>L(k).filter(x=>x.d>=a&&x.d<=b);
const lastW=()=>[...L('weight')].sort((a,b)=>a.d.localeCompare(b.d)).at(-1);
const hl=(d,k)=>Math.max((S.hab[d]||{})[k]||0,on(AUTO[k],d).length?1:0);
function save(){S.t=Date.now();try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}clearTimeout(st);st=setTimeout(()=>{if(DBR)DBR.set({j:JSON.stringify(S),t:S.t}).then(()=>{SYNC='aktif'}).catch(()=>{})},1500)}
(async()=>{try{if(!window.claude)throw 0;const u=await claude.use('user'),db=await claude.use('db');const id=u&&await u.id();if(!db||!id)throw 0;DBR=db.collection('data/users/'+id).doc('plms');const s=await DBR.get();SYNC='aktif';if(s.exists){const c=JSON.parse(s.data().j);if((c.t||0)>(S.t||0)){S=c;norm();try{localStorage.setItem(K,JSON.stringify(S))}catch(e){}render()}else if((S.t||0)>(c.t||0))save()}else if(S.t)save()}catch(e){SYNC='tidak aktif (data hanya di browser ini)'}})();
const toast=m=>{const t=$('#toast');t.textContent=m;t.style.opacity=1;setTimeout(()=>t.style.opacity=0,2500)};
const pb=(p,l,t)=>`<div class="pb"><div><span>${l}</span><b>${t}</b></div><i><u style="width:${Math.max(0,Math.min(100,p||0))}%"></u></i></div>`;
function chart(ss,o={}){const ds=[...new Set(ss.flatMap(s=>s.p.map(p=>p.d)))].sort();if(ds.length<2)return'<p class="mu">Grafik muncul setelah ada minimal 2 data.</p>';
let vs=ss.flatMap(s=>s.p.map(p=>p.v));if(o.ref!=null)vs.push(o.ref);let a=o.min??Math.min(...vs),b=o.max??Math.max(...vs);if(a===b){a-=1;b+=1}const pd=(b-a)*.1;a-=pd;b+=pd;
const X=d=>30+ds.indexOf(d)*(280/(ds.length-1)),Y=v=>110-(v-a)/(b-a)*95;let h=`<svg viewBox="0 0 320 135" width="100%">`;
if(o.ref!=null)h+=`<line x1="30" x2="310" y1="${Y(o.ref)}" y2="${Y(o.ref)}" stroke="var(--wr)" stroke-dasharray="4"/><text x="310" y="${Y(o.ref)-3}" font-size="9" text-anchor="end" fill="var(--wr)">target ${o.ref}</text>`;
ss.forEach(s=>{h+=`<polyline fill="none" stroke="${s.c}" stroke-width="2" points="${s.p.map(p=>X(p.d)+','+Y(p.v)).join(' ')}"/>`+s.p.map(p=>`<circle cx="${X(p.d)}" cy="${Y(p.v)}" r="3" fill="${s.c}"/>`).join('')});
return h+`<text x="30" y="130" font-size="9" fill="var(--mu)">${ds[0].slice(5)}</text><text x="310" y="130" font-size="9" text-anchor="end" fill="var(--mu)">${ds.at(-1).slice(5)}</text><text x="0" y="${Y(b-pd)+3}" font-size="9" fill="var(--mu)">${r1(b-pd)}</text><text x="0" y="${Y(a+pd)+3}" font-size="9" fill="var(--mu)">${r1(a+pd)}</text></svg>`}
const bars=(it,u='')=>{const m=Math.max(...it.map(x=>x.v),1);return`<div class="bars">`+it.map(x=>`<div><small>${r1(x.v)}${u}</small><i style="height:${x.v/m*80}px"></i><small>${x.l}</small></div>`).join('')+`</div>`};
const series=(k,f,c)=>({c,p:Object.values(Object.fromEntries([...L(k)].sort((a,b)=>a.d.localeCompare(b.d)).map(x=>[x.d,{d:x.d,v:+x[f]}])))});
const D={k:'d',l:'Tanggal',t:'date',d:today};
function sec(k,title,F,o){const it=ED[k]?L(k).find(x=>x.id===ED[k]):PRE[k];let h=`<div class="card"><h3>${title}</h3><form data-k="${k}" class="frm">`;
F.forEach(f=>{const v=it?it[f.k]:typeof f.d==='function'?f.d():f.d??'';h+=`<label>${f.l}`+(f.t==='select'?`<select name="${f.k}">${f.o.map(x=>`<option${x==v?' selected':''}>${esc(x)}</option>`).join('')}</select>`:f.t==='textarea'?`<textarea name="${f.k}" rows="2">${esc(v)}</textarea>`:`<input name="${f.k}" type="${f.t||'text'}" value="${esc(v)}"${f.t==='number'?' step="any" min="0"':''}${f.r?' required':''}>`)+`</label>`});
h+=`<div class="row"><button class="btn">${ED[k]?'Simpan perubahan':'Tambah'}</button>${ED[k]?`<button type="button" class="btn g" data-cancel="${k}">Batal</button>`:''}</div></form>`;
const rows=[...L(k)].sort((a,b)=>(o.asc?1:-1)*(a.d||'').localeCompare(b.d||'')).slice(0,o.n||6);
return h+rows.map(x=>`<div class="it"><div>${o.r(x)}</div><div class="ac"><button data-e="${k}:${x.id}">✎</button><button data-x="${k}:${x.id}">${PEND===k+':'+x.id?'Hapus?':'🗑'}</button></div></div>`).join('')+(L(k).length>(o.n||6)?`<small>+${L(k).length-(o.n||6)} data lama (ada di ekspor)</small>`:'')+`</div>`}
const dt=x=>`<span class="mu">${x.d}</span>`;
const habW=d=>H.map(h=>{const v=hl(d,h.k);return`<div class="hb"><b>${h.n}</b><div class="lv">`+['Belum','Minimum','Normal','Optimal'].map((n,i)=>`<button class="pl${v===i?' on':''}" data-h="${h.k}:${i}:${d}">${n}</button>`).join('')+`</div><small>${v?esc(h.l[v-1]):'Minimum sudah dihitung konsisten.'}</small></div>`}).join('');
const SCHL=t=>S.sch[t].split('\n').map(l=>l.split('|')).filter(p=>p[1]).map(p=>{const m=p[0].trim().split('.');return[(+m[0])*60+(+m[1]||0),p[0].trim(),p[1].trim()]});
const wtr=ws=>{if(ws.length<2)return null;const l=ws.at(-1),r=ws.find(x=>x.d>=addD(l.d,-14))||ws[0],dd=(Date.parse(l.d)-Date.parse(r.d))/864e5;return dd>=5?(l.kg-r.kg)/dd*7:null};
P.home=()=>{const t=today(),dy=S.day[t]||'normal',tg={busy:45,normal:100,free:150}[dy],stm=sum(on('study',t),x=>x.minutes),q=on('quran',t),w=lastW(),m=on('mood',t).at(-1),done=H.filter(h=>hl(t,h.k)>0).length,wk=inR('work',addD(t,-6),t).length,nm=nowM(),sc=SCHL(dy),cur=sc.filter(x=>x[0]<=nm).length-1;
return`<div class="grid"><div class="card"><h3>Ringkasan hari ini</h3>${pb(done/6*100,'Kebiasaan',done+' / 6')}${pb(stm/tg*100,'Belajar mandiri (hari '+LBLD[dy].toLowerCase()+')',hm(stm)+' / '+tg+' m')}${pb(sum(q,x=>x.menit)/20*100,'Al-Qur’an',sum(q,x=>x.menit)+' menit')}<p class="mu">Minimum tetap berarti konsisten. Hari yang tenang juga hari yang berhasil.</p></div>
<div class="card"><h3>Sekilas</h3><div class="g2"><div><b>${w?r1(w.kg)+' kg':'–'}</b><span>Berat terakhir · target ${S.set.wt} kg</span></div><div><b>${hm(stm)}</b><span>Belajar hari ini</span></div><div><b>${sum(q.filter(x=>x.jenis==='Hafalan'),x=>x.ayat)} ayat</b><span>Hafalan hari ini</span></div><div><b>${on('work',t).length?'Sudah ✓':wk+' / 3'}</b><span>${on('work',t).length?'Olahraga hari ini':'Olahraga 7 hari'}</span></div><div><b>${m?m.energi+' / '+m.fokus:'–'}</b><span>Energi / fokus (1–5)</span></div></div></div>
<div class="card"><h3>Checklist hari ini</h3>${habW(t)}</div>
<div class="card"><h3>Jadwal hari ini</h3><div class="lv">${['busy','normal','free'].map(k=>`<button class="pl${dy===k?' on':''}" data-day="${k}">${LBLD[k]}</button>`).join('')}</div>${sc.map((x,i)=>`<div class="sc${i===cur?' now':''}"><b>${x[1]}</b>${esc(x[2])}</div>`).join('')}<small>Ubah isi jadwal di menu Jadwal.</small></div></div>`};
P.fis=()=>{const t=today(),s=S.set,ws=[...L('weight')].sort((a,b)=>a.d.localeCompare(b.d)),cur=ws.at(-1)?.kg??s.w0,rem=s.wt-cur,tr=wtr(ws),ft=on('food',t),wk=inR('work',addD(t,-6),t).length,sl=inR('sleep',addD(t,-6),t);
return`<div class="grid"><div class="card"><h3>Berat badan</h3>${pb((cur-s.w0)/(s.wt-s.w0)*100,'Menuju target',r1(cur)+' → '+s.wt+' kg')}<p class="mu">Sisa ${r1(Math.max(rem,0))} kg. Laju realistis ±${s.rate} kg/minggu${rem>0?' (± '+Math.ceil(rem/s.rate)+' minggu)':''}.${tr==null?'':' Tren 2 minggu: <b>'+r1(tr)+' kg/minggu</b>.'}${ws.length&&t>addD(ws.at(-1).d,7)?' Sudah lebih dari seminggu sejak timbang terakhir.':''}</p>${chart([series('weight','kg','var(--ac)')],{ref:s.wt})}</div>`+
sec('weight','Catat berat badan',[D,{k:'kg',l:'Berat (kg)',t:'number',r:1}],{r:x=>`<b>${r1(x.kg)} kg</b> ${dt(x)}`})+
`<div class="card"><h3>Asupan hari ini</h3>${pb(sum(ft,x=>x.kcal)/s.kcal*100,'Kalori',Math.round(sum(ft,x=>x.kcal))+' / '+s.kcal+' kkal')}${pb(sum(ft,x=>x.prot)/s.prot*100,'Protein',Math.round(sum(ft,x=>x.prot))+' / '+s.prot+' g')}${pb(sum(on('water',t),x=>x.ml)/s.air*100,'Air',sum(on('water',t),x=>x.ml)+' / '+s.air+' ml')}<div class="lv"><button class="pl" data-w="250">+250 ml</button><button class="pl" data-w="500">+500 ml</button></div></div>`+
