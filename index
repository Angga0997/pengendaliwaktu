.big{font-size:44px;font-weight:700;font-variant-numeric:tabular-nums}.bars{display:flex;gap:6px;align-items:flex-end;height:125px}.bars div{flex:1;text-align:center;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:2px}.bars i{display:block;width:100%;background:var(--ac);border-radius:6px 6px 0 0;min-height:2px}.bars small{font-size:10px}
.sc{display:flex;gap:10px;padding:5px 0;font-size:14px;color:var(--mu)}.sc b{min-width:48px;color:var(--tx)}.sc.now{color:var(--tx);font-weight:600}.sc.now b{color:var(--ac)}
.mx{display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0}.mx span{width:130px}.mx i{width:18px;height:18px;border-radius:5px;background:var(--ac);display:inline-block}.mx i.d0{background:var(--bd)}.mx i.d1{opacity:.4}.mx i.d2{opacity:.7}
.tw{overflow-x:auto}table{border-collapse:collapse;font-size:13px;width:100%}td,th{padding:6px 8px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:8px 14px;border-radius:99px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none}
@media(max-width:760px){nav{position:fixed;top:auto;bottom:0;left:0;right:0;width:auto;height:auto;flex-direction:row;overflow-x:auto;padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));background:var(--cd);border-top:1px solid var(--bd);border-right:0;z-index:5}.brand{display:none}.nv{flex-direction:column;gap:0;font-size:10px;min-width:62px;text-align:center;padding:5px}.nv b{font-size:18px;font-weight:400}main{padding-bottom:100px}.grid{grid-template-columns:1fr}}
</style></head><body><div id="app"><nav id="nav"></nav><main id="main"></main></div><div id="toast"></div>
<script>
'use strict';
const tz='Asia/Jakarta',$=s=>document.querySelector(s),K='plms-v1',P={};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nowM=()=>{const p=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date()).split(':');return(+p[0]%24)*60+ +p[1]};
const today=()=>new Intl.DateTimeFormat('en-CA',{timeZone:tz}).format(new Date());
const addD=(d,n)=>{const x=new Date(d+'T12:00:00Z');x.setUTCDate(x.getUTCDate()+n);return x.toISOString().slice(0,10)};
const DAYS=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'],dow=d=>new Date(d+'T12:00:00Z').getUTCDay();
const fmtD=d=>new Intl.DateTimeFormat('id-ID',{timeZone:'UTC',weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(new Date(d+'T12:00:00Z'));
const uid=()=>Math.random().toString(36).slice(2,9),sum=(a,f)=>a.reduce((s,x)=>s+(+f(x)||0),0),avg=(a,f)=>a.length?sum(a,f)/a.length:null;
const r1=n=>n==null?'–':String(Math.round(n*10)/10).replace('.',','),hm=m=>Math.floor(m/60)+' j '+Math.round(m%60)+' m';
const SCH0={busy:`04.00|Bangun & ibadah Subuh
04.30|Tilawah, hafalan, murajaah (20 menit)
